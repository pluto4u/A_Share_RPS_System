    {"code": "AI_PCB", "name": "AI服务器PCB与电子材料", "description": "从AI服务器、交换机和高速互连需求反推覆铜板、电子布、铜箔、加工工具、设备和高多层PCB。", "demand_driver": "AI服务器与交换机层数、速率和价值量提升", "thesis": "高端材料认证、良率、扩产周期和客户结构决定利润分配。", "status": "research", "as_of_date": "2026-07-15"},
    {"code": "SEMICONDUCTOR", "name": "半导体制造设备材料与芯片", "description": "覆盖设计、制造、设备、材料、测试、存储和洁净厂务。", "demand_driver": "AI算力、存储景气与国产替代资本开支", "thesis": "有效产能、工艺验证、客户认证和设备稼动率优先于概念映射。", "status": "research", "as_of_date": "2026-07-15"},
