{用户提供的原公式。检查时保留原有语义，不混入V2附加条件。}
M5:=MA(C,5);
M10:=MA(C,10);
M20:=MA(C,20);
M60:=MA(C,60);
M120:=MA(C,120);
VM20:=MA(V,20);
DIF:=EMA(C,12)-EMA(C,26);
DEA:=EMA(DIF,9);
MH:=2*(DIF-DEA);
BASE:=BARSCOUNT(C)>250 AND NOT(NAMELIKE('ST')) AND NOT(NAMELIKE('*ST'));
DD:=(HHV(H,60)-LLV(L,30))/HHV(H,60)>=0.28;
LOWNEAR:=LLVBARS(L,30)<=15;
YJ:=DD AND LOWNEAR AND C>M20 AND M5>M10 AND M5>REF(M5,2)
    AND C>REF(HHV(H,5),1) AND MH>0 AND MH>REF(MH,1) AND C/M20<=1.12;
QD:=DD AND LOWNEAR AND C>M20 AND M5>M10 AND C>M120
    AND C>REF(HHV(H,10),1) AND V>=VM20*1.10 AND MH>0;
QR:=DD AND C>M60 AND M10>M20 AND C>REF(HHV(H,20),1) AND MH>0;
QQR:=QR AND V>=VM20*1.80 AND DIF>0;
XG:BASE AND (YJ OR QD OR QR OR QQR);
